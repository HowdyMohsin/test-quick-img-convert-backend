# Quick IMG Convert — API environment (placeholders only, no real secrets).
# Copy to .env for local runs. Production values come from the host.

DATABASE_URL=postgresql+asyncpg://qic:change-me@postgres:5432/qic
# Local SQLite dev alternative:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
APP_SECRET=change-me-to-a-different-long-random-string-at-least-32-chars
SITE_URL=http://localhost:3000
QUOTA_TZ=Asia/Karachi
DATA_DIR=/data
RETENTION_HOURS=24
ENV=development
API_DOCS=false
# First-boot pair health check (converts bundled samples once, in the
# background, only when the pair_health table is empty). Set to 0 on
# small instances (Render free tier) to skip it at boot and save memory;
# the admin formats page then shows no health data until a check is run.
QIC_STARTUP_HEALTH_CHECK=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PKR_PER_USD=280
APPROVAL_WINDOW_HOURS=24
