# Quick IMG Convert — API environment (placeholders only, no real secrets).
# Copy to .env for local runs. Production values come from the host.

DATABASE_URL=postgresql+asyncpg://qic:change-me@postgres:5432/qic
# Local SQLite dev alternative:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
APP_SECRET=change-me-to-a-different-long-random-string-at-least-32-chars
SITE_URL=http://localhost:3000
QUOTA_TZ=Asia/Karachi
DATA_DIR=/data
RETENTION_HOURS=24
ENV=development
API_DOCS=false
# First-boot pair health check (converts bundled samples once, in the
# background, only when the pair_health table is empty). Set to 0 on
# small instances (Render free tier) to skip it at boot and save memory;
# the admin formats page then shows no health data until a check is run.
QIC_STARTUP_HEALTH_CHECK=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
# Paddle: API key + client-side token + webhook secret. For SANDBOX
# testing use the sandbox dashboard's test keys (client token starts
# with "test_") and store sandbox price ids per plan; the checkout
# response then carries sandbox=true and the frontend loads Paddle.js
# in sandbox mode.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Lemon Squeezy: for TEST mode use the store's test-mode API key and
# test-mode variant ids (stored per plan); same hosted checkout URL.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Stripe — TEST MODE ONLY. Only test keys are accepted (sk_test_… /
# pk_test_…); live keys are refused everywhere in code. Webhook secret
# is the signing secret of the test-mode webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PKR_PER_USD=280
APPROVAL_WINDOW_HOURS=24
# TEMPORARY (test-only): email verification gating for registration +
# purchase. Default true (verification ON). Set to false on the test
# deployment only so unverified users can register and check out while
# testing; re-enable by removing it or setting it to true.
REQUIRE_EMAIL_VERIFICATION=true
